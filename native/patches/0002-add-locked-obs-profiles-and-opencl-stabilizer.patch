diff --git a/app/deps/ffmpeg.sh b/app/deps/ffmpeg.sh
index 78affd3..8907d9d 100755
--- a/app/deps/ffmpeg.sh
+++ b/app/deps/ffmpeg.sh
@@ -9,6 +9,7 @@ SHA256SUM=464beb5e7bf0c311e68b45ae2f04e9cc2af88851abb4082231742a74d97b524c
 
 PROJECT_DIR="ffmpeg-$VERSION"
 FILENAME="$PROJECT_DIR.tar.xz"
+FFMPEG_PATCH_DIRECTORY="$PWD/patches/ffmpeg"
 
 cd "$SOURCES_DIR"
 
@@ -20,6 +21,19 @@ else
     tar xf "$FILENAME"  # First level directory is "$PROJECT_DIR"
 fi
 
+for ffmpeg_patch in "$FFMPEG_PATCH_DIRECTORY"/*.patch
+do
+    if patch --dry-run --silent -d "$PROJECT_DIR" -p1 < "$ffmpeg_patch"
+    then
+        patch -d "$PROJECT_DIR" -p1 < "$ffmpeg_patch"
+    elif ! patch --dry-run --silent --reverse -d "$PROJECT_DIR" -p1 \
+            < "$ffmpeg_patch"
+    then
+        echo "FFmpeg patch does not apply cleanly: $ffmpeg_patch" >&2
+        exit 1
+    fi
+done
+
 mkdir -p "$BUILD_DIR/$PROJECT_DIR"
 cd "$BUILD_DIR/$PROJECT_DIR"
 
@@ -60,6 +74,13 @@ else
         --disable-vdpau
         --enable-opencl
         --enable-filter=deshake_opencl
+        --enable-filter=buffer
+        --enable-filter=buffersink
+        --enable-filter=crop
+        --enable-filter=format
+        --enable-filter=lenscorrection
+        --enable-filter=hwdownload
+        --enable-filter=hwupload
         --enable-swresample
         --enable-libdav1d
         --enable-decoder=h264
