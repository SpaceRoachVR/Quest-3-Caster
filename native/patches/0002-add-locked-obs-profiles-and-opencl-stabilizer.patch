diff --git a/app/src/q3c/native_event.c b/app/src/q3c/native_event.c
new file mode 100644
index 0000000..7b25745
--- /dev/null
+++ b/app/src/q3c/native_event.c
@@ -0,0 +1,157 @@
+#include "q3c/native_event.h"
+
+#include <stdio.h>
+#include <string.h>
+
+static unsigned
+q3c_utf8_sequence_length(const unsigned char *source) {
+    unsigned char first = source[0];
+    if (first < 0x80) {
+        return 1;
+    }
+    if (first >= 0xC2 && first <= 0xDF && source[1]
+            && (source[1] & 0xC0) == 0x80) {
+        return 2;
+    }
+    if (first >= 0xE0 && first <= 0xEF && source[1] && source[2]
+            && (source[1] & 0xC0) == 0x80
+            && (source[2] & 0xC0) == 0x80
+            && !(first == 0xE0 && source[1] < 0xA0)
+            && !(first == 0xED && source[1] >= 0xA0)) {
+        return 3;
+    }
+    if (first >= 0xF0 && first <= 0xF4 && source[1] && source[2] && source[3]
+            && (source[1] & 0xC0) == 0x80
+            && (source[2] & 0xC0) == 0x80
+            && (source[3] & 0xC0) == 0x80
+            && !(first == 0xF0 && source[1] < 0x90)
+            && !(first == 0xF4 && source[1] >= 0x90)) {
+        return 4;
+    }
+    return 0;
+}
+
+bool
+q3c_utf8_sanitize(const char *source, char *destination, size_t capacity) {
+    if (!source || !destination || capacity < 2) {
+        return false;
+    }
+    size_t read_index = 0;
+    size_t write_index = 0;
+    while (source[read_index]) {
+        const unsigned char *current =
+            (const unsigned char *) &source[read_index];
+        unsigned length = q3c_utf8_sequence_length(current);
+        if (!length) {
+            length = 1;
+            if (write_index + 1 >= capacity) {
+                return false;
+            }
+            destination[write_index++] = '?';
+        } else {
+            if (write_index + length >= capacity) {
+                return false;
+            }
+            if (length == 1 && current[0] < 0x20) {
+                destination[write_index++] = ' ';
+            } else {
+                memcpy(&destination[write_index], current, length);
+                write_index += length;
+            }
+        }
+        read_index += length;
+    }
+    destination[write_index] = '\0';
+    return write_index > 0;
+}
+
+bool
+q3c_json_escape(char *destination, size_t capacity, const char *source) {
+    if (!destination || !capacity || !source) {
+        return false;
+    }
+    size_t used = 0;
+    for (const unsigned char *p = (const unsigned char *) source; *p; ++p) {
+        char encoded[7];
+        size_t count;
+        switch (*p) {
+            case '"': strcpy(encoded, "\\\""); count = 2; break;
+            case '\\': strcpy(encoded, "\\\\"); count = 2; break;
+            case '\b': strcpy(encoded, "\\b"); count = 2; break;
+            case '\f': strcpy(encoded, "\\f"); count = 2; break;
+            case '\n': strcpy(encoded, "\\n"); count = 2; break;
+            case '\r': strcpy(encoded, "\\r"); count = 2; break;
+            case '\t': strcpy(encoded, "\\t"); count = 2; break;
+            default:
+                if (*p < 0x20) {
+                    snprintf(encoded, sizeof(encoded), "\\u%04x", *p);
+                    count = 6;
+                } else {
+                    encoded[0] = (char) *p;
+                    count = 1;
+                }
+        }
+        if (used + count >= capacity) {
+            destination[0] = '\0';
+            return false;
+        }
+        memcpy(destination + used, encoded, count);
+        used += count;
+    }
+    destination[used] = '\0';
+    return true;
+}
+
+bool
+q3c_event_ready(char *destination, size_t capacity, const char *profile,
+                uint32_t width, uint32_t height, bool stabilized,
+                const char *gpu_name, uint16_t delay_ms,
+                uint64_t generation) {
+    char escaped_profile[80];
+    char escaped_gpu[512];
+    if (!q3c_json_escape(escaped_profile, sizeof(escaped_profile), profile)
+            || (gpu_name && !q3c_json_escape(escaped_gpu, sizeof(escaped_gpu),
+                                             gpu_name))) {
+        return false;
+    }
+    int written = snprintf(destination, capacity,
+        Q3C_EVENT_PREFIX
+        "{\"schemaVersion\":1,\"type\":\"ready\",\"code\":\"stream_ready\","
+        "\"effectiveProfile\":\"%s\",\"output\":{\"width\":%u,"
+        "\"height\":%u},\"stabilization\":{\"active\":%s},\"gpu\":%s%s%s,"
+        "\"nominalDelayMs\":%u,\"generation\":%llu}",
+        escaped_profile, width, height, stabilized ? "true" : "false",
+        gpu_name ? "\"" : "null", gpu_name ? escaped_gpu : "",
+        gpu_name ? "\"" : "", delay_ms, (unsigned long long) generation);
+    return written > 0 && (size_t) written < capacity
+        && written <= Q3C_EVENT_MAX_BYTES;
+}
+
+bool
+q3c_event_diagnostic(char *destination, size_t capacity, bool fatal,
+                     const char *code, const char *message) {
+    char escaped_code[96];
+    char escaped_message[2048];
+    if (!q3c_json_escape(escaped_code, sizeof(escaped_code), code)
+            || !q3c_json_escape(escaped_message, sizeof(escaped_message),
+                                message)) {
+        return false;
+    }
+    int written = snprintf(destination, capacity,
+        Q3C_EVENT_PREFIX
+        "{\"schemaVersion\":1,\"type\":\"%s\",\"code\":\"%s\","
+        "\"message\":\"%s\"}",
+        fatal ? "fatal" : "warning", escaped_code, escaped_message);
+    return written > 0 && (size_t) written < capacity
+        && written <= Q3C_EVENT_MAX_BYTES;
+}
+
+void
+q3c_event_emit(const char *event) {
+    if (event && strlen(event) <= Q3C_EVENT_MAX_BYTES
+            && !strchr(event, '\n') && !strchr(event, '\r')) {
+        fputs(event, stdout);
+        fputc('\n', stdout);
+        fflush(stdout);
+    }
+}
