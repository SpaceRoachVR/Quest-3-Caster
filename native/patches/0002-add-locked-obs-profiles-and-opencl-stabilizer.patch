+
+#include "q3c/native_event.h"
+
+#define Q3C_INPUT_WIDTH 2064
+#define Q3C_INPUT_HEIGHT 1160
+#define Q3C_OUTPUT_WIDTH 1920
+#define Q3C_OUTPUT_HEIGHT 1080
+#define Q3C_FINAL_CROP_X ((Q3C_INPUT_WIDTH - Q3C_OUTPUT_WIDTH) / 2)
+#define Q3C_FINAL_CROP_Y ((Q3C_INPUT_HEIGHT - Q3C_OUTPUT_HEIGHT) / 2)
+
+AVRational
+q3c_stabilization_time_base(void) {
+    return (AVRational) {1, 1000000};
+}
+
+enum q3c_delay_action
+q3c_delay_action_for_age(int64_t age_us) {
+    if (age_us < 0) {
+        return Q3C_DELAY_INVALID;
+    }
+    if (age_us < Q3C_NOMINAL_DELAY_US) {
+        return Q3C_DELAY_WAIT;
+    }
+    if (age_us <= Q3C_MAXIMUM_DELAY_US) {
+        return Q3C_DELAY_DELIVER;
+    }
+    return Q3C_DELAY_DROP_STALE;
+}
+
+bool
+q3c_transform_covers_final_crop(const double transform[6], uint32_t width,
+                                uint32_t height) {
+    if (!transform || width != Q3C_INPUT_WIDTH || height != Q3C_INPUT_HEIGHT) {
+        return false;
+    }
+    const double corners[4][2] = {
+        {Q3C_FINAL_CROP_X, Q3C_FINAL_CROP_Y},
+        {Q3C_FINAL_CROP_X + Q3C_OUTPUT_WIDTH - 1, Q3C_FINAL_CROP_Y},
+        {Q3C_FINAL_CROP_X, Q3C_FINAL_CROP_Y + Q3C_OUTPUT_HEIGHT - 1},
+        {Q3C_FINAL_CROP_X + Q3C_OUTPUT_WIDTH - 1,
+         Q3C_FINAL_CROP_Y + Q3C_OUTPUT_HEIGHT - 1},
+    };
+    for (unsigned i = 0; i < 4; ++i) {
+        double x = corners[i][0] * transform[0]
+                 + corners[i][1] * transform[1] + transform[2];
+        double y = corners[i][0] * transform[3]
+                 + corners[i][1] * transform[4] + transform[5];
+        if (!isfinite(x) || !isfinite(y) || x < 0 || y < 0
+                || x > width - 1 || y > height - 1) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static bool
+q3c_parse_transform_metadata(const AVFrame *frame, double transform[6]) {
+    const AVDictionaryEntry *entry = av_dict_get(
+        frame->metadata, "lavfi.q3c.transform_y", NULL, 0);
+    if (!entry || !entry->value) {
+        return false;
+    }
+    const char *cursor = entry->value;
+    for (unsigned i = 0; i < 6; ++i) {
+        errno = 0;
+        char *end;
+        transform[i] = strtod(cursor, &end);
+        if (errno == ERANGE || end == cursor || !isfinite(transform[i])) {
+            return false;
+        }
+        if (i < 5) {
+            if (*end != ',') {
+                return false;
+            }
+            cursor = end + 1;
+        } else if (*end != '\0') {
+            return false;
+        }
+    }
+    return true;
+}
+
+bool
+q3c_stabilization_frame_covers_final_crop(const AVFrame *frame) {
+    double transform[6];
+    return frame && q3c_parse_transform_metadata(frame, transform)
+        && q3c_transform_covers_final_crop(
+            transform, Q3C_INPUT_WIDTH, Q3C_INPUT_HEIGHT);
+}
+
+bool
+q3c_select_first_gpu(const uint64_t *device_types, size_t device_count,
+                     uint64_t gpu_type_mask, size_t *selected_index) {
+    if (!device_types || !gpu_type_mask || !selected_index) {
+        return false;
+    }
+    for (size_t i = 0; i < device_count; ++i) {
+        if (device_types[i] & gpu_type_mask) {
+            *selected_index = i;
+            return true;
+        }
+    }
+    return false;
+}
+
+static bool
+q3c_select_opencl_gpu(char *selector, size_t selector_capacity) {
+    if (!selector || selector_capacity < 4) {
+        return false;
+    }
+#ifdef _WIN32
+    HMODULE module = LoadLibraryW(L"OpenCL.dll");
+    if (!module) {
+        return false;
+    }
+    typedef cl_int (CL_API_CALL *q3c_cl_get_platform_ids_fn)(
+        cl_uint, cl_platform_id *, cl_uint *);
+    typedef cl_int (CL_API_CALL *q3c_cl_get_device_ids_fn)(
+        cl_platform_id, cl_device_type, cl_uint, cl_device_id *, cl_uint *);
+    typedef cl_int (CL_API_CALL *q3c_cl_get_device_info_fn)(
+        cl_device_id, cl_device_info, size_t, void *, size_t *);
+    q3c_cl_get_platform_ids_fn get_platform_ids =
+        (q3c_cl_get_platform_ids_fn) (void *)
+        GetProcAddress(module, "clGetPlatformIDs");
+    q3c_cl_get_device_ids_fn get_device_ids =
+        (q3c_cl_get_device_ids_fn) (void *)
+        GetProcAddress(module, "clGetDeviceIDs");
+    q3c_cl_get_device_info_fn get_device_info =
+        (q3c_cl_get_device_info_fn) (void *)
+        GetProcAddress(module, "clGetDeviceInfo");
+    if (!get_platform_ids || !get_device_ids || !get_device_info) {
+        FreeLibrary(module);
+        return false;
+    }
+#else
+# define get_platform_ids clGetPlatformIDs
+# define get_device_ids clGetDeviceIDs
+# define get_device_info clGetDeviceInfo
+#endif
+
+    cl_uint platform_count = 0;
+    cl_int result = get_platform_ids(0, NULL, &platform_count);
+    cl_platform_id *platforms = NULL;
+    bool selected = false;
+    if (result != CL_SUCCESS || !platform_count) {
+        goto end;
+    }
+    platforms = calloc(platform_count, sizeof(*platforms));
+    if (!platforms
+            || get_platform_ids(platform_count, platforms, NULL)
+                    != CL_SUCCESS) {
+        goto end;
+    }
+
+    for (cl_uint p = 0; p < platform_count && !selected; ++p) {
+        cl_uint device_count = 0;
+        result = get_device_ids(platforms[p], CL_DEVICE_TYPE_ALL, 0, NULL,
+                                &device_count);
+        if (result == CL_DEVICE_NOT_FOUND || !device_count) {
+            continue;
+        }
+        if (result != CL_SUCCESS) {
+            continue;
+        }
+        cl_device_id *devices = calloc(device_count, sizeof(*devices));
+        uint64_t *types = calloc(device_count, sizeof(*types));
+        if (!devices || !types) {
+            free(devices);
+            free(types);
+            goto end;
+        }
+        result = get_device_ids(platforms[p], CL_DEVICE_TYPE_ALL,
+                                device_count, devices, NULL);
+        if (result == CL_SUCCESS) {
+            for (cl_uint d = 0; d < device_count; ++d) {
+                cl_device_type type = 0;
+                if (get_device_info(devices[d], CL_DEVICE_TYPE, sizeof(type),
+                                    &type, NULL) == CL_SUCCESS) {
+                    types[d] = (uint64_t) type;
+                }
+            }
+            size_t device_index;
+            if (q3c_select_first_gpu(types, device_count,
+                                     (uint64_t) CL_DEVICE_TYPE_GPU,
+                                     &device_index)) {
+                int written = snprintf(selector, selector_capacity, "%u.%zu",
+                                       p, device_index);
+                selected = written > 0
+                        && (size_t) written < selector_capacity;
+            }
+        }
+        free(devices);
+        free(types);
+    }
+
+end:
+    free(platforms);
+#ifdef _WIN32
+    FreeLibrary(module);
+#else
+# undef get_platform_ids
+# undef get_device_ids
+# undef get_device_info
+#endif
+    return selected;
+}
+
+static void
+q3c_set_error(char *destination, size_t capacity, const char *operation,
+              int result) {
+    if (!destination || !capacity) {
+        return;
+    }
+    char detail[AV_ERROR_MAX_STRING_SIZE];
+    av_strerror(result, detail, sizeof(detail));
+    snprintf(destination, capacity, "%s: %s", operation, detail);
+}
+
+static bool
+q3c_query_gpu(AVBufferRef *device_ref, char *destination, size_t capacity) {
+    AVHWDeviceContext *device_context = (AVHWDeviceContext *) device_ref->data;
+    AVOpenCLDeviceContext *opencl =
+        (AVOpenCLDeviceContext *) device_context->hwctx;
+    if (!opencl || !opencl->device_id) {
+        return false;
+    }
+    size_t length = 0;
+    cl_device_type device_type = 0;
+    char raw_name[512];
+#ifdef _WIN32
+    HMODULE module = LoadLibraryW(L"OpenCL.dll");
+    if (!module) {
+        return false;
+    }
+    typedef cl_int (CL_API_CALL *q3c_cl_get_device_info_fn)(
+        cl_device_id, cl_device_info, size_t, void *, size_t *);
+    q3c_cl_get_device_info_fn get_device_info =
+        (q3c_cl_get_device_info_fn) (void *)
+        GetProcAddress(module, "clGetDeviceInfo");
+    if (!get_device_info) {
+        FreeLibrary(module);
+        return false;
+    }
+    cl_int result = get_device_info(opencl->device_id, CL_DEVICE_TYPE,
+                                    sizeof(device_type), &device_type, NULL);
+    if (result == CL_SUCCESS && (device_type & CL_DEVICE_TYPE_GPU)) {
+        result = get_device_info(opencl->device_id, CL_DEVICE_NAME,
+                                 sizeof(raw_name), raw_name, &length);
+    }
+    FreeLibrary(module);
+#else
+    cl_int result = clGetDeviceInfo(opencl->device_id, CL_DEVICE_TYPE,
+                                    sizeof(device_type), &device_type, NULL);
+    if (result == CL_SUCCESS && (device_type & CL_DEVICE_TYPE_GPU)) {
+        result = clGetDeviceInfo(opencl->device_id, CL_DEVICE_NAME,
+                                 sizeof(raw_name), raw_name, &length);
+    }
+#endif
+    if (result != CL_SUCCESS || !(device_type & CL_DEVICE_TYPE_GPU)
+            || length <= 1 || length > sizeof(raw_name)) {
+        return false;
+    }
+    raw_name[sizeof(raw_name) - 1] = '\0';
+    return q3c_utf8_sanitize(raw_name, destination, capacity);
+}
+
+static AVFilterContext *
+q3c_create_filter(struct q3c_stabilization_filter *filter,
+                  const char *filter_name, const char *instance_name,
+                  const char *arguments, char *error, size_t error_capacity) {
+    const AVFilter *definition = avfilter_get_by_name(filter_name);
+    if (!definition) {
+        if (error && error_capacity) {
+            snprintf(error, error_capacity, "required filter unavailable: %s",
+                     filter_name);
+        }
+        return NULL;
+    }
+    AVFilterContext *context =
+        avfilter_graph_alloc_filter(filter->graph, definition, instance_name);
+    if (!context) {
+        q3c_set_error(error, error_capacity, "filter allocation",
+                      AVERROR(ENOMEM));
+        return NULL;
+    }
+    context->hw_device_ctx = av_buffer_ref(filter->device);
+    if (!context->hw_device_ctx) {
+        q3c_set_error(error, error_capacity, "OpenCL context reference",
+                      AVERROR(ENOMEM));
+        return NULL;
+    }
+    int result = avfilter_init_str(context, arguments);
+    if (result < 0) {
+        q3c_set_error(error, error_capacity, instance_name, result);
+        return NULL;
+    }
+    return context;
+}
+
+bool
+q3c_stabilization_filter_open(struct q3c_stabilization_filter *filter,
+                              uint32_t width, uint32_t height,
+                              enum AVPixelFormat format, AVRational time_base,
+                              bool force_failure, char *error,
+                              size_t error_capacity) {
+    if (!filter || width != Q3C_INPUT_WIDTH || height != Q3C_INPUT_HEIGHT
+            || format != AV_PIX_FMT_YUV420P || time_base.num <= 0
+            || time_base.den <= 0) {
+        if (error && error_capacity) {
+            snprintf(error, error_capacity, "unexpected input geometry/format");
+        }
+        return false;
+    }
+    memset(filter, 0, sizeof(*filter));
+    filter->last_input_pts = AV_NOPTS_VALUE;
+    filter->last_filter_output_pts = AV_NOPTS_VALUE;
+    filter->last_delivered_pts = AV_NOPTS_VALUE;
+    filter->time_base = time_base;
+    filter->input_format = format;
+    if (force_failure) {
+        if (error && error_capacity) {
+            snprintf(error, error_capacity, "forced OpenCL initialization failure");
+        }
+        return false;
+    }
+
+    char device_selector[32];
+    if (!q3c_select_opencl_gpu(device_selector, sizeof(device_selector))) {
+        if (error && error_capacity) {
+            snprintf(error, error_capacity,
+                     "No deterministic OpenCL GPU selection is available");
+        }
+        goto fail;
+    }
+    AVDictionary *device_options = NULL;
+    int result = av_dict_set(&device_options, "device_type", "gpu", 0);
+    if (result >= 0) {
+        result = av_hwdevice_ctx_create(&filter->device,
+                                        AV_HWDEVICE_TYPE_OPENCL,
+                                        device_selector, device_options, 0);
+    }
+    av_dict_free(&device_options);
+    if (result < 0) {
+        q3c_set_error(error, error_capacity, "OpenCL device initialization",
+                      result);
+        goto fail;
+    }
+    if (!q3c_query_gpu(filter->device, filter->gpu_name,
+                       sizeof(filter->gpu_name))) {
+        if (error && error_capacity) {
+            snprintf(error, error_capacity,
+                     "OpenCL device is not a usable GPU or its name is invalid");
+        }
+        goto fail;
+    }
+
+    filter->graph = avfilter_graph_alloc();
+    filter->output = av_frame_alloc();
+    filter->delivered = av_frame_alloc();
+    if (!filter->graph || !filter->output || !filter->delivered) {
+        q3c_set_error(error, error_capacity, "filter allocation",
+                      AVERROR(ENOMEM));
+        goto fail;
+    }
+
+    char source_args[256];
+    snprintf(source_args, sizeof(source_args),
+             "video_size=%ux%u:pix_fmt=%d:time_base=%d/%d:"
+             "pixel_aspect=1/1:frame_rate=60/1",
+             width, height, format, time_base.num, time_base.den);
+    result = avfilter_graph_create_filter(
+        &filter->source, avfilter_get_by_name("buffer"), "q3c_input",
+        source_args, NULL, filter->graph);
+    if (result < 0) {
+        q3c_set_error(error, error_capacity, "buffer source initialization",
+                      result);
+        goto fail;
+    }
+    result = avfilter_graph_create_filter(
+        &filter->sink, avfilter_get_by_name("buffersink"), "q3c_output",
+        NULL, NULL, filter->graph);
+    if (result < 0) {
+        q3c_set_error(error, error_capacity, "buffer sink initialization",
+                      result);
+        goto fail;
+    }
+
+    AVFilterContext *format_in = q3c_create_filter(
+        filter, "format", "q3c_format_in", "pix_fmts=yuv420p",
+        error, error_capacity);
+    AVFilterContext *upload = q3c_create_filter(
+        filter, "hwupload", "q3c_hwupload", NULL, error, error_capacity);
+    AVFilterContext *deshake = q3c_create_filter(
+        filter, "deshake_opencl", "q3c_deshake",
+        "smooth_strength=0.0:refine_features=1:"
+        "smooth_window_multiplier=0.1:adaptive_crop=0",
+        error, error_capacity);
+    AVFilterContext *download = q3c_create_filter(
+        filter, "hwdownload", "q3c_hwdownload", NULL, error, error_capacity);
+    AVFilterContext *format_out = q3c_create_filter(
+        filter, "format", "q3c_format_out", "pix_fmts=yuv420p",
+        error, error_capacity);
+    /* crop=1920:1080:(iw-1920)/2:(ih-1080)/2 */
+    AVFilterContext *crop = q3c_create_filter(
+        filter, "crop", "q3c_crop",
+        "w=1920:h=1080:x=(iw-1920)/2:y=(ih-1080)/2",
+        error, error_capacity);
+    if (!format_in || !upload || !deshake || !download || !format_out
+            || !crop) {
+        goto fail;
+    }
+
+    AVFilterContext *chain[] = {
+        filter->source, format_in, upload, deshake, download, format_out,
+        crop, filter->sink,
+    };
+    for (size_t i = 0; i + 1 < sizeof(chain) / sizeof(chain[0]); ++i) {
+        result = avfilter_link(chain[i], 0, chain[i + 1], 0);
+        if (result < 0) {
+            q3c_set_error(error, error_capacity, "stabilization graph link",
+                          result);
+            goto fail;
+        }
+    }
+
+    result = avfilter_graph_config(filter->graph, NULL);
+    if (result < 0) {
+        q3c_set_error(error, error_capacity, "stabilization graph configure",
+                      result);
+        goto fail;
+    }
+    return true;
+
+fail:
+    q3c_stabilization_filter_close(filter);
+    return false;
+}
+
+void
+q3c_stabilization_filter_close(struct q3c_stabilization_filter *filter) {
+    if (!filter) {
+        return;
+    }
+    av_frame_free(&filter->output);
+    av_frame_free(&filter->delivered);
+    for (unsigned i = 0; i < Q3C_MAX_QUEUED_FRAMES; ++i) {
+        av_frame_free(&filter->delay_queue[i]);
+    }
+    avfilter_graph_free(&filter->graph);
+    av_buffer_unref(&filter->device);
+    filter->source = NULL;
+    filter->sink = NULL;
+    filter->queued_frames = 0;
+    filter->delay_head = 0;
+    filter->delay_count = 0;
+    filter->peak_queue_depth = 0;
+    filter->gpu_name[0] = '\0';
+    filter->last_input_pts = AV_NOPTS_VALUE;
+    filter->last_filter_output_pts = AV_NOPTS_VALUE;
+    filter->last_delivered_pts = AV_NOPTS_VALUE;
+    filter->last_submission_to_output_ms = 0;
+}
+
+bool
+q3c_stabilization_filter_reset(struct q3c_stabilization_filter *filter,
+                               uint32_t width, uint32_t height,
+                               enum AVPixelFormat format,
+                               AVRational time_base, bool force_failure,
+                               char *error, size_t error_capacity) {
+    q3c_stabilization_filter_close(filter);
+    return q3c_stabilization_filter_open(filter, width, height, format,
+                                         time_base, force_failure, error,
+                                         error_capacity);
+}
+
+bool
+q3c_stabilization_filter_push(struct q3c_stabilization_filter *filter,
+                              const AVFrame *input, AVFrame **output,
+                              bool *has_output, char *error,
+                              size_t error_capacity) {
+    if (!filter || !filter->graph || !input || !output || !has_output) {
+        if (error && error_capacity) {
+            snprintf(error, error_capacity, "filter is not initialized");
+        }
+        return false;
+    }
+    if (input->width != Q3C_INPUT_WIDTH || input->height != Q3C_INPUT_HEIGHT) {
+        if (error && error_capacity) {
+            snprintf(error, error_capacity, "unexpected input geometry");
+        }
+        return false;
+    }
+    if (input->format != filter->input_format
+            || input->format != AV_PIX_FMT_YUV420P) {
+        if (error && error_capacity) {
+            snprintf(error, error_capacity, "unexpected input pixel format");
+        }
+        return false;
+    }
+    if (input->pts == AV_NOPTS_VALUE
+            || (filter->last_input_pts != AV_NOPTS_VALUE
+                && input->pts <= filter->last_input_pts)) {
+        if (error && error_capacity) {
+            snprintf(error, error_capacity,
+                     "input timestamp is missing or non-monotonic");
+        }
+        return false;
+    }
+    filter->last_input_pts = input->pts;
+
+    int result = av_buffersrc_add_frame_flags(
+        filter->source, (AVFrame *) input, AV_BUFFERSRC_FLAG_KEEP_REF);
+    if (result < 0) {
+        q3c_set_error(error, error_capacity, "stabilization frame submit",
+                      result);
+        return false;
+    }
+    ++filter->queued_frames;
+    if (filter->queued_frames > filter->peak_queue_depth) {
+        filter->peak_queue_depth = filter->queued_frames;
+    }
+
+    av_frame_unref(filter->output);
+    result = av_buffersink_get_frame(filter->sink, filter->output);
+    if (result == AVERROR(EAGAIN)) {
+        *has_output = false;
+        *output = NULL;
+        return true;
+    }
+    if (result < 0) {
+        q3c_set_error(error, error_capacity, "stabilization frame receive",
+                      result);
+        return false;
+    }
+    if (filter->queued_frames) {
+        --filter->queued_frames;
+    }
+    if (filter->output->width != Q3C_OUTPUT_WIDTH
+            || filter->output->height != Q3C_OUTPUT_HEIGHT) {
+        if (error && error_capacity) {
+            snprintf(error, error_capacity, "unexpected output geometry");
+        }
+        return false;
+    }
+    if (filter->output->format != AV_PIX_FMT_YUV420P
+            || filter->output->pts == AV_NOPTS_VALUE
+            || (filter->last_filter_output_pts != AV_NOPTS_VALUE
+                && filter->output->pts <= filter->last_filter_output_pts)) {
+        if (error && error_capacity) {
+            snprintf(error, error_capacity,
+                     "output format or timestamp is invalid/non-monotonic");
+        }
+        return false;
+    }
+    filter->last_filter_output_pts = filter->output->pts;
+
+    if (filter->delay_count == Q3C_MAX_QUEUED_FRAMES) {
+        AVFrame *oldest = filter->delay_queue[filter->delay_head];
+        int64_t oldest_age_us = av_rescale_q(
+            input->pts - oldest->pts, filter->time_base, AV_TIME_BASE_Q);
+        if (q3c_delay_action_for_age(oldest_age_us)
+                != Q3C_DELAY_DROP_STALE) {
+            if (error && error_capacity) {
+                snprintf(error, error_capacity, "video delay queue is full");
+            }
+            return false;
+        }
+        av_frame_free(&filter->delay_queue[filter->delay_head]);
+        filter->delay_head =
+            (filter->delay_head + 1) % Q3C_MAX_QUEUED_FRAMES;
+        --filter->delay_count;
+    }
+
+    unsigned tail = (filter->delay_head + filter->delay_count)
+                  % Q3C_MAX_QUEUED_FRAMES;
+    filter->delay_queue[tail] = av_frame_clone(filter->output);
+    if (!filter->delay_queue[tail]) {
+        q3c_set_error(error, error_capacity, "video delay frame clone",
+                      AVERROR(ENOMEM));
+        return false;
+    }
+    ++filter->delay_count;
+    unsigned total_depth = filter->queued_frames + filter->delay_count;
+    if (total_depth > filter->peak_queue_depth) {
+        filter->peak_queue_depth = total_depth;
+    }
+
+    while (filter->delay_count) {
+        AVFrame *oldest = filter->delay_queue[filter->delay_head];
+        int64_t age_us = av_rescale_q(input->pts - oldest->pts,
+                                      filter->time_base, AV_TIME_BASE_Q);
+        enum q3c_delay_action action = q3c_delay_action_for_age(age_us);
+        if (action == Q3C_DELAY_WAIT) {
+            *has_output = false;
+            *output = NULL;
+            return true;
+        }
+        if (action == Q3C_DELAY_INVALID) {
+            if (error && error_capacity) {
+                snprintf(error, error_capacity,
+                         "video delay timestamp is invalid");
+            }
+            return false;
+        }
+        if (action == Q3C_DELAY_DROP_STALE) {
+            av_frame_free(&filter->delay_queue[filter->delay_head]);
+            filter->delay_head =
+                (filter->delay_head + 1) % Q3C_MAX_QUEUED_FRAMES;
+            --filter->delay_count;
+            continue;
+        }
+
+        if (oldest->pts == AV_NOPTS_VALUE
+                || (filter->last_delivered_pts != AV_NOPTS_VALUE
+                    && oldest->pts <= filter->last_delivered_pts)) {
+            if (error && error_capacity) {
+                snprintf(error, error_capacity,
+                         "delivered timestamp is missing or non-monotonic");
+            }
+            return false;
+        }
+        av_frame_unref(filter->delivered);
+        av_frame_move_ref(filter->delivered, oldest);
+        av_frame_free(&filter->delay_queue[filter->delay_head]);
+        filter->delay_head =
+            (filter->delay_head + 1) % Q3C_MAX_QUEUED_FRAMES;
+        --filter->delay_count;
+        filter->last_delivered_pts = filter->delivered->pts;
+        filter->last_submission_to_output_ms = (unsigned) (age_us / 1000);
+        *has_output = true;
+        *output = filter->delivered;
+        return true;
+    }
+
+    *has_output = false;
+    *output = NULL;
+    return true;
+}
diff --git a/app/src/q3c/stabilization_filter.h b/app/src/q3c/stabilization_filter.h
