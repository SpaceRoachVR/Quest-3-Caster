diff --git a/app/deps/patches/ffmpeg/0005-export-transform-metadata.patch b/app/deps/patches/ffmpeg/0005-export-transform-metadata.patch
new file mode 100644
index 0000000..ab367bc
--- /dev/null
+++ b/app/deps/patches/ffmpeg/0005-export-transform-metadata.patch
@@ -0,0 +1,24 @@
+--- a/libavfilter/vf_deshake_opencl.c
++++ b/libavfilter/vf_deshake_opencl.c
+@@ -1700,5 +1700,20 @@ static int filter_frame(AVFilterLink *link, AVFrame *input_frame)
+         err = av_frame_copy_props(transformed_frame, input_frame);
+         if (err < 0)
+             goto fail;
++
++        char q3c_transform[256];
++        int q3c_transform_length = snprintf(
++            q3c_transform, sizeof(q3c_transform),
++            "%.9g,%.9g,%.9g,%.9g,%.9g,%.9g",
++            transform_y[0], transform_y[1], transform_y[2],
++            transform_y[3], transform_y[4], transform_y[5]);
++        if (q3c_transform_length < 0
++                || q3c_transform_length >= (int) sizeof(q3c_transform)) {
++            err = AVERROR(EINVAL);
++            goto fail;
++        }
++        err = av_dict_set(&transformed_frame->metadata,
++                          "lavfi.q3c.transform_y", q3c_transform, 0);
++        if (err < 0)
++            goto fail;
+-
+         av_frame_free(&cropped_frame);
