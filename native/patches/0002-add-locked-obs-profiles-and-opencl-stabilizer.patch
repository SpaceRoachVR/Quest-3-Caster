diff --git a/app/src/q3c/capabilities.c b/app/src/q3c/capabilities.c
new file mode 100644
index 0000000..33ee51b
--- /dev/null
+++ b/app/src/q3c/capabilities.c
@@ -0,0 +1,45 @@
+#include "q3c/capabilities.h"
+
+#include <stdio.h>
+
+#include <libavutil/pixfmt.h>
+
+#include "q3c/native_event.h"
+#include "q3c/stabilization_filter.h"
+
+bool
+q3c_print_capabilities(void) {
+    struct q3c_stabilization_filter filter;
+    char error[512];
+    bool available = q3c_stabilization_filter_open(
+        &filter, 2064, 1160, AV_PIX_FMT_YUV420P, (AVRational) {1, 60},
+        false, error, sizeof(error));
+
+    char gpu[512] = "null";
+    if (available) {
+        char escaped[384];
+        if (!q3c_json_escape(escaped, sizeof(escaped), filter.gpu_name)) {
+            q3c_stabilization_filter_close(&filter);
+            return false;
+        }
+        snprintf(gpu, sizeof(gpu), "\"%s\"", escaped);
+    }
+
+    printf("{\"schemaVersion\":1,\"upstreamVersion\":\"4.1\","
+           "\"forkVersion\":\"quest3caster-stabilization-1\","
+           "\"profiles\":[\"obsLowLatency1080p60\","
+           "\"obsStabilized1080p60\"],"
+           "\"stabilizationModes\":[\"off\",\"openclFeaturePoint\"],"
+           "\"openclAvailable\":%s,\"gpu\":%s,"
+           "\"output\":{\"width\":1920,\"height\":1080},"
+           "\"delays\":{\"lowLatencyNominalMs\":0,"
+           "\"stabilizedNominalMs\":100,\"stabilizedMaximumMs\":120},"
+           "\"calibratedSource\":{\"width\":4128,\"height\":2208},"
+           "\"diagnostic\":\"%s\"}\n",
+           available ? "true" : "false", gpu,
+           available ? "ready" : "OpenCL stabilization unavailable");
+    if (available) {
+        q3c_stabilization_filter_close(&filter);
+    }
+    return true;
+}
