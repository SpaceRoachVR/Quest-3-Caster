         return false;
     }
 
+    if (opts->q3c_capabilities) {
+        if (opts->q3c_profile_id != Q3C_PROFILE_NONE
+                || opts->q3c_generation_set || q3c_locked_option_seen) {
+            LOGE("--q3c-capabilities cannot be combined with stream options");
+            return false;
+        }
+        return true;
+    }
+
+    if (opts->q3c_profile_id != Q3C_PROFILE_NONE) {
+        if (!opts->q3c_generation_set || q3c_locked_option_seen) {
+            LOGE("Locked OBS profiles require exactly one generation and "
+                 "reject custom codec/crop/rate/buffer options");
+            return false;
+        }
+        if (!opts->window || !opts->video || !opts->video_playback) {
+            LOGE("Locked OBS profile video streams require a window, video "
+                 "capture, and video playback");
+            return false;
+        }
+        const struct q3c_profile *profile =
+            q3c_profile_get(opts->q3c_profile_id);
+        assert(profile);
+        opts->crop = profile->server_crop;
+        opts->video_codec = SC_CODEC_H264;
+        opts->video_bit_rate = profile->video_bit_rate;
+        opts->max_fps = "60";
+        opts->max_size = profile->stabilized ? 0 : profile->output_width;
+        opts->video_buffer = 0;
+        opts->downsize_on_error = false;
+        opts->window_width = profile->window_width;
+        opts->window_height = profile->window_height;
+        opts->angle = profile->presentation_angle;
+        if (opts->audio) {
+            opts->audio_source = SC_AUDIO_SOURCE_PLAYBACK;
+            opts->audio_codec = SC_CODEC_OPUS;
+            opts->audio_dup = true;
+        }
+        if (profile->stabilized) {
+            opts->audio_buffer = SC_TICK_FROM_MS(100);
+        }
+    } else if (opts->q3c_generation_set) {
+        LOGE("--q3c-generation requires --q3c-profile");
+        return false;
+    }
+
     // If a TCP/IP address is provided, then tcpip must be enabled
     assert(opts->tcpip || !opts->tcpip_dst);
 
diff --git a/app/src/frame_buffer.c b/app/src/frame_buffer.c
index 699a3f3..dba8c2d 100644
--- a/app/src/frame_buffer.c
+++ b/app/src/frame_buffer.c
@@ -62,6 +62,14 @@ sc_frame_buffer_push(struct sc_frame_buffer *fb, const AVFrame *frame) {
     return true;
 }
 
+void
+sc_frame_buffer_discard(struct sc_frame_buffer *fb) {
+    if (!fb->pending_frame_consumed) {
+        av_frame_unref(fb->pending_frame);
+        fb->pending_frame_consumed = true;
+    }
+}
+
 void
 sc_frame_buffer_consume(struct sc_frame_buffer *fb, AVFrame *dst) {
     assert(!fb->pending_frame_consumed);
@@ -71,3 +79,12 @@ sc_frame_buffer_consume(struct sc_frame_buffer *fb, AVFrame *dst) {
     // av_frame_move_ref() resets its source frame, so no need to call
     // av_frame_unref()
 }
+
+bool
+sc_frame_buffer_try_consume(struct sc_frame_buffer *fb, AVFrame *dst) {
+    if (!sc_frame_buffer_has_frame(fb)) {
+        return false;
+    }
+    sc_frame_buffer_consume(fb, dst);
+    return true;
+}
