+#ifndef Q3C_STABILIZATION_FILTER_H
+#define Q3C_STABILIZATION_FILTER_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#include <libavfilter/avfilter.h>
+#include <libavutil/frame.h>
+#include <libavutil/pixfmt.h>
+#include <libavutil/rational.h>
+
+#define Q3C_NOMINAL_DELAY_US 100000
+#define Q3C_MAXIMUM_DELAY_US 120000
+#define Q3C_MAX_QUEUED_FRAMES 12
+
+enum q3c_delay_action {
+    Q3C_DELAY_WAIT,
+    Q3C_DELAY_DELIVER,
+    Q3C_DELAY_DROP_STALE,
+    Q3C_DELAY_INVALID,
+};
+
+struct q3c_stabilization_filter {
+    AVFilterGraph *graph;
+    AVFilterContext *source;
+    AVFilterContext *sink;
+    AVBufferRef *device;
+    AVFrame *output;
+    AVFrame *delivered;
+    AVFrame *delay_queue[Q3C_MAX_QUEUED_FRAMES];
+    unsigned delay_head;
+    unsigned delay_count;
+    AVRational time_base;
+    enum AVPixelFormat input_format;
+    int64_t last_input_pts;
+    int64_t last_filter_output_pts;
+    int64_t last_delivered_pts;
+    unsigned last_submission_to_output_ms;
+    char gpu_name[256];
+    unsigned queued_frames;
+    unsigned peak_queue_depth;
+};
+
+enum q3c_delay_action
+q3c_delay_action_for_age(int64_t age_us);
+
+AVRational
+q3c_stabilization_time_base(void);
+
+bool
+q3c_stabilization_filter_reset(struct q3c_stabilization_filter *filter,
+                               uint32_t width, uint32_t height,
+                               enum AVPixelFormat format,
+                               AVRational time_base, bool force_failure,
+                               char *error, size_t error_capacity);
+
+bool
+q3c_stabilization_filter_open(struct q3c_stabilization_filter *filter,
+                              uint32_t width, uint32_t height,
+                              enum AVPixelFormat format, AVRational time_base,
+                              bool force_failure, char *error,
+                              size_t error_capacity);
+
+void
+q3c_stabilization_filter_close(struct q3c_stabilization_filter *filter);
+
+bool
+q3c_stabilization_filter_push(struct q3c_stabilization_filter *filter,
+                              const AVFrame *input, AVFrame **output,
+                              bool *has_output, char *error,
+                              size_t error_capacity);
+
+bool
+q3c_select_first_gpu(const uint64_t *device_types, size_t device_count,
+                     uint64_t gpu_type_mask, size_t *selected_index);
+
+bool
+q3c_transform_covers_final_crop(const double transform[6], uint32_t width,
+                                uint32_t height);
+
+bool
+q3c_stabilization_frame_covers_final_crop(const AVFrame *frame);
+
+#endif
diff --git a/app/src/q3c/stabilization_sink.c b/app/src/q3c/stabilization_sink.c
new file mode 100644
index 0000000..6a86681
--- /dev/null
+++ b/app/src/q3c/stabilization_sink.c
@@ -0,0 +1,384 @@
+#include "q3c/stabilization_sink.h"
+
+#include <stdio.h>
+#include <string.h>
+
+#ifdef Q3C_NATIVE_TESTS
+#include <SDL3/SDL_mutex.h>
+#endif
+
+#include "q3c/native_event.h"
+
+#define DOWNCAST(SINK) \
+    container_of(SINK, struct q3c_stabilization_sink, frame_sink)
+
+static void
+q3c_emit_fatal(struct q3c_stabilization_sink *sink, const char *code,
+               const char *message) {
+    char event[Q3C_EVENT_MAX_BYTES + 1];
+    if (q3c_event_diagnostic(event, sizeof(event), true, code, message)) {
+        sink->event_emitter(event);
+    }
+}
+
+static struct sc_stream_session
+q3c_corrected_session(const struct sc_stream_session *session,
+                      uint64_t epoch) {
+    struct sc_stream_session corrected = *session;
+    corrected.video.width = 1920;
+    corrected.video.height = 1080;
+    corrected.q3c_epoch = epoch;
+    return corrected;
+}
+
+static bool
+q3c_validate_forwarded_frame(struct q3c_stabilization_sink *sink,
+                             const AVFrame *frame) {
+    if (frame->width != (int) sink->profile->output_width
+            || frame->height != (int) sink->profile->output_height
+            || frame->format != AV_PIX_FMT_YUV420P) {
+        q3c_emit_fatal(sink, "unexpected_output_geometry",
+                       "Effective output must be 1920x1080 YUV420P.");
+        return false;
+    }
+    if (frame->pts == AV_NOPTS_VALUE
+            || (sink->last_forwarded_pts != AV_NOPTS_VALUE
+                && frame->pts <= sink->last_forwarded_pts)) {
+        q3c_emit_fatal(sink, "invalid_video_timestamp",
+                       "Effective output timestamp is missing or "
+                       "non-monotonic.");
+        return false;
+    }
+    sink->last_forwarded_pts = frame->pts;
+    return true;
+}
+
+static bool
+q3c_stabilization_sink_open_impl(
+        struct q3c_stabilization_sink *sink, const AVCodecContext *context,
+        const struct sc_stream_session *session) {
+    if (!q3c_profile_validate_geometry(sink->profile, context->width,
+                                       context->height, false)
+            || context->pix_fmt != AV_PIX_FMT_YUV420P) {
+        q3c_emit_fatal(sink, "unexpected_input_geometry",
+                       "Decoded input geometry/format does not match the "
+                       "locked OBS profile; both crops require a 4128x2208 "
+                       "Quest 3 source.");
+        return false;
+    }
+
+    sink->input_width = context->width;
+    sink->input_height = context->height;
+    sink->input_format = context->pix_fmt;
+    sink->input_time_base = q3c_stabilization_time_base();
+    sink->session_epoch = 1;
+    sink->last_forwarded_pts = AV_NOPTS_VALUE;
+
+    if (sink->profile->stabilized) {
+        char error[512];
+        if (!q3c_stabilization_filter_open(
+                &sink->filter, context->width, context->height,
+                context->pix_fmt, sink->input_time_base, false, error,
+                sizeof(error))) {
+            q3c_emit_fatal(sink, "stabilization_unavailable", error);
+            return false;
+        }
+        snprintf(sink->gpu_name, sizeof(sink->gpu_name), "%s",
+                 sink->filter.gpu_name);
+    }
+
+    sink->output_context = avcodec_alloc_context3(NULL);
+    if (!sink->output_context) {
+        q3c_stabilization_filter_close(&sink->filter);
+        q3c_emit_fatal(sink, "stabilization_unavailable",
+                       "Could not allocate effective output context.");
+        return false;
+    }
+    sink->output_context->codec_type = AVMEDIA_TYPE_VIDEO;
+    sink->output_context->pix_fmt = AV_PIX_FMT_YUV420P;
+    sink->output_context->width = sink->profile->output_width;
+    sink->output_context->height = sink->profile->output_height;
+    sink->output_context->time_base = sink->input_time_base;
+    struct sc_stream_session corrected =
+        q3c_corrected_session(session, sink->session_epoch);
+    if (!sc_frame_source_sinks_open(&sink->frame_source,
+                                    sink->output_context, &corrected)) {
+        avcodec_free_context(&sink->output_context);
+        q3c_stabilization_filter_close(&sink->filter);
+        return false;
+    }
+    sink->open = true;
+    return true;
+}
+
+static bool
+q3c_stabilization_frame_sink_open(struct sc_frame_sink *frame_sink,
+                                  const AVCodecContext *context,
+                                  const struct sc_stream_session *session) {
+    return q3c_stabilization_sink_open_impl(DOWNCAST(frame_sink), context,
+                                            session);
+}
+
+static void
+q3c_stabilization_frame_sink_close(struct sc_frame_sink *frame_sink) {
+    struct q3c_stabilization_sink *sink = DOWNCAST(frame_sink);
+#ifdef Q3C_NATIVE_TESTS
+    if (sink->close_observer) {
+        bool try_lock_acquired = SDL_TryLockMutex(sink->mutex.mutex);
+        if (try_lock_acquired) {
+            SDL_UnlockMutex(sink->mutex.mutex);
+        }
+        sink->close_observer(sink->close_observer_userdata,
+            try_lock_acquired ? Q3C_CLOSE_TRY_MUTEX_ACQUIRED
+                              : Q3C_CLOSE_TRY_MUTEX_BUSY);
+    }
+#endif
+    sc_mutex_lock(&sink->mutex);
+#ifdef Q3C_NATIVE_TESTS
+    if (sink->close_observer) {
+        sink->close_observer(sink->close_observer_userdata,
+                             Q3C_CLOSE_AFTER_MUTEX);
+    }
+#endif
+    sink->ready_emitted = false;
+    sink->pending_ready = false;
+    sink->pending_ready_acknowledged = false;
+    sink->pending_ready_push_in_progress = false;
+    sink->open = false;
+    sc_mutex_unlock(&sink->mutex);
+    sc_frame_source_sinks_close(&sink->frame_source);
+    avcodec_free_context(&sink->output_context);
+    q3c_stabilization_filter_close(&sink->filter);
+    sink->last_forwarded_pts = AV_NOPTS_VALUE;
+    sink->gpu_name[0] = '\0';
+}
+
+static bool
+q3c_publish_ready_locked(struct q3c_stabilization_sink *sink) {
+    char event[Q3C_EVENT_MAX_BYTES + 1];
+    if (!q3c_event_ready(event, sizeof(event), sink->profile->name,
+                         sink->profile->output_width,
+                         sink->profile->output_height,
+                         sink->profile->stabilized,
+                         sink->profile->stabilized ? sink->gpu_name : NULL,
+                         sink->profile->nominal_video_delay_ms,
+                         sink->generation)) {
+        return false;
+    }
+    sink->event_emitter(event);
+    sink->ready_emitted = true;
+    sink->pending_ready = false;
+    sink->pending_ready_acknowledged = false;
+    return true;
+}
+
+static void
+q3c_rollback_pending_ready(struct q3c_stabilization_sink *sink,
+                           uint64_t epoch, int64_t pts) {
+    sc_mutex_lock(&sink->mutex);
+    if (!sink->ready_emitted && sink->pending_ready
+            && sink->pending_ready_epoch == epoch
+            && sink->pending_ready_pts == pts) {
+        sink->pending_ready = false;
+        sink->pending_ready_acknowledged = false;
+        sink->pending_ready_push_in_progress = false;
+    }
+    sc_mutex_unlock(&sink->mutex);
+}
+
+static bool
+q3c_forward_effective_frame(struct q3c_stabilization_sink *sink,
+                            const AVFrame *frame) {
+    if (!q3c_validate_forwarded_frame(sink, frame)) {
+        return false;
+    }
+
+    uint64_t epoch;
+    sc_mutex_lock(&sink->mutex);
+    if (!sink->open) {
+        sc_mutex_unlock(&sink->mutex);
+        return false;
+    }
+    epoch = sink->session_epoch;
+    sink->pending_ready_pts = frame->pts;
+    sink->pending_ready_epoch = epoch;
+    sink->pending_ready = true;
+    sink->pending_ready_acknowledged = false;
+    sink->pending_ready_push_in_progress = true;
+    sc_mutex_unlock(&sink->mutex);
+
+    bool pushed = sc_frame_source_sinks_push(&sink->frame_source, frame);
+    if (!pushed) {
+        q3c_rollback_pending_ready(sink, epoch, frame->pts);
+        return false;
+    }
+
+    bool publication_ok = true;
+    sc_mutex_lock(&sink->mutex);
+    if (sink->pending_ready && sink->pending_ready_epoch == epoch
+            && sink->pending_ready_pts == frame->pts) {
+        sink->pending_ready_push_in_progress = false;
+        if (sink->open && sink->pending_ready_acknowledged
+                && !sink->ready_emitted) {
+            publication_ok = q3c_publish_ready_locked(sink);
+        }
+    }
+    sc_mutex_unlock(&sink->mutex);
+    return publication_ok;
+}
+
+static bool
+q3c_forward_stabilized_output(struct q3c_stabilization_sink *sink,
+                              const AVFrame *frame) {
+    if (!q3c_stabilization_frame_covers_final_crop(frame)) {
+        q3c_emit_fatal(sink, "stabilization_unavailable",
+                       "Stabilization transform exposes the calibrated "
+                       "overscan border.");
+        return false;
+    }
+    return q3c_forward_effective_frame(sink, frame);
+}
+
+static bool
+q3c_stabilization_frame_sink_push(struct sc_frame_sink *frame_sink,
+                                  const AVFrame *frame) {
+    struct q3c_stabilization_sink *sink = DOWNCAST(frame_sink);
+    if (!sink->open) {
+        q3c_emit_fatal(sink, "stabilization_unavailable",
+                       "Frame arrived while the profile sink was closed.");
+        return false;
+    }
+    if (!sink->profile->stabilized) {
+        return q3c_forward_effective_frame(sink, frame);
+    }
+
+    AVFrame *output;
+    bool has_output;
+    char error[512];
+    if (!q3c_stabilization_filter_push(&sink->filter, frame, &output,
+                                       &has_output, error, sizeof(error))) {
+        const char *code = strstr(error, "geometry")
+                         ? "unexpected_output_geometry"
+                         : strstr(error, "timestamp")
+                         ? "invalid_video_timestamp"
+                         : "stabilization_unavailable";
+        q3c_emit_fatal(sink, code, error);
+        return false;
+    }
+    if (!has_output) {
+        return true;
+    }
+    return q3c_forward_stabilized_output(sink, output);
+}
+
+static bool
+q3c_stabilization_frame_sink_push_session(
+        struct sc_frame_sink *frame_sink,
+        const struct sc_stream_session *session) {
+    struct q3c_stabilization_sink *sink = DOWNCAST(frame_sink);
+    sc_mutex_lock(&sink->mutex);
+    ++sink->session_epoch;
+    sink->ready_emitted = false;
+    sink->pending_ready = false;
+    sink->pending_ready_acknowledged = false;
+    sink->pending_ready_push_in_progress = false;
+    sc_mutex_unlock(&sink->mutex);
+    sink->last_forwarded_pts = AV_NOPTS_VALUE;
+
+    if (sink->profile->stabilized) {
+        char error[512];
+        if (!q3c_stabilization_filter_reset(
+                &sink->filter, sink->input_width, sink->input_height,
+                sink->input_format, sink->input_time_base, false, error,
+                sizeof(error))) {
+            q3c_emit_fatal(sink, "stabilization_unavailable", error);
+            return false;
+        }
+        snprintf(sink->gpu_name, sizeof(sink->gpu_name), "%s",
+                 sink->filter.gpu_name);
+    }
+    struct sc_stream_session corrected =
+        q3c_corrected_session(session, sink->session_epoch);
+    return sc_frame_source_sinks_push_session(&sink->frame_source, &corrected);
+}
+
+void
+q3c_stabilization_sink_ack_rendered(
+        void *userdata, const AVFrame *frame,
+        const struct sc_stream_session *session) {
+    struct q3c_stabilization_sink *sink = userdata;
+    if (!sink || !frame || !session || frame->width != 1920
+            || frame->height != 1080 || frame->format != AV_PIX_FMT_YUV420P
+            || frame->pts == AV_NOPTS_VALUE || session->video.width != 1920
+            || session->video.height != 1080) {
+        return;
+    }
+
+    sc_mutex_lock(&sink->mutex);
+    if (sink->open && !sink->ready_emitted && sink->pending_ready
+            && session->q3c_epoch == sink->pending_ready_epoch
+            && frame->pts == sink->pending_ready_pts) {
+        sink->pending_ready_acknowledged = true;
+        if (!sink->pending_ready_push_in_progress
+                && !q3c_publish_ready_locked(sink)) {
+            char event[Q3C_EVENT_MAX_BYTES + 1];
+            if (q3c_event_diagnostic(
+                    event, sizeof(event), true,
+                    "stabilization_unavailable",
+                    "Could not encode native readiness event.")) {
+                sink->event_emitter(event);
+            }
+        }
+    }
+    sc_mutex_unlock(&sink->mutex);
+}
+
+bool
+q3c_stabilization_sink_init(struct q3c_stabilization_sink *sink,
+                            const struct q3c_profile *profile,
+                            uint64_t generation,
+                            q3c_native_event_emitter event_emitter) {
+    if (!sink || !profile || !profile->stabilized || !generation) {
+        return false;
+    }
+    memset(sink, 0, sizeof(*sink));
+    if (!sc_mutex_init(&sink->mutex)) {
+        return false;
+    }
+    sink->profile = profile;
+    sink->generation = generation;
+    sink->event_emitter = event_emitter ? event_emitter : q3c_event_emit;
+    sink->last_forwarded_pts = AV_NOPTS_VALUE;
+    sc_frame_source_init(&sink->frame_source);
+    static const struct sc_frame_sink_ops operations = {
+        .open = q3c_stabilization_frame_sink_open,
+        .close = q3c_stabilization_frame_sink_close,
+        .push = q3c_stabilization_frame_sink_push,
+        .push_session = q3c_stabilization_frame_sink_push_session,
+    };
+    sink->frame_sink.ops = &operations;
+    return true;
+}
+
+void
+q3c_stabilization_sink_destroy(struct q3c_stabilization_sink *sink) {
+    if (sink->open) {
+        q3c_stabilization_frame_sink_close(&sink->frame_sink);
+    }
+    sc_mutex_destroy(&sink->mutex);
+}
+
+#ifdef Q3C_NATIVE_TESTS
+bool
+q3c_stabilization_sink_open_for_test(
+        struct q3c_stabilization_sink *sink, const AVCodecContext *context,
+        const struct sc_stream_session *session) {
+    return q3c_stabilization_sink_open_impl(sink, context, session);
+}
+
+bool
+q3c_stabilization_sink_forward_output_for_test(
+        struct q3c_stabilization_sink *sink, const AVFrame *frame) {
+    return q3c_forward_stabilized_output(sink, frame);
+}
+#endif
