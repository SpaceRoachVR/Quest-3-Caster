@@ -0,0 +1,99 @@
+#include "q3c/profile.h"
+
+#include <errno.h>
+#include <stdlib.h>
+#include <string.h>
+
+static const struct q3c_profile profiles[] = {
+    {
+        .id = Q3C_PROFILE_OBS_LOW_LATENCY_1080P60,
+        .name = "obsLowLatency1080p60",
+        .server_crop = "1792:1008:2200:600",
+        .presentation_angle = "-22",
+        .input_width = 1792,
+        .input_height = 1008,
+        .output_width = 1792,
+        .output_height = 1008,
+        .window_width = 1792,
+        .window_height = 1008,
+        .video_bit_rate = 40000000,
+        .max_fps = 60,
+        .audio_delay_ms = 0,
+        .nominal_video_delay_ms = 0,
+        .maximum_video_delay_ms = 0,
+        .stabilized = false,
+    },
+    {
+        .id = Q3C_PROFILE_OBS_STABILIZED_1080P60,
+        .name = "obsStabilized1080p60",
+        .server_crop = "2064:1160:2064:524",
+        .presentation_angle = "-22",
+        .input_width = 2064,
+        .input_height = 1160,
+        .output_width = 1920,
+        .output_height = 1080,
+        .window_width = 1920,
+        .window_height = 1080,
+        .video_bit_rate = 40000000,
+        .max_fps = 60,
+        .audio_delay_ms = 100,
+        .nominal_video_delay_ms = 100,
+        .maximum_video_delay_ms = 120,
+        .stabilized = true,
+    },
+};
+
+bool
+q3c_profile_parse(const char *value, enum q3c_profile_id *id) {
+    if (!value || !id) {
+        return false;
+    }
+
+    for (size_t i = 0; i < sizeof(profiles) / sizeof(profiles[0]); ++i) {
+        if (!strcmp(value, profiles[i].name)) {
+            *id = profiles[i].id;
+            return true;
+        }
+    }
+    return false;
+}
+
+const struct q3c_profile *
+q3c_profile_get(enum q3c_profile_id id) {
+    for (size_t i = 0; i < sizeof(profiles) / sizeof(profiles[0]); ++i) {
+        if (profiles[i].id == id) {
+            return &profiles[i];
+        }
+    }
+    return NULL;
+}
+
+bool
+q3c_generation_parse(const char *value, uint64_t *generation) {
+    if (!value || !*value || !generation || value[0] == '+'
+            || value[0] == '-' || value[0] == '0') {
+        return false;
+    }
+
+    errno = 0;
+    char *end;
+    unsigned long long parsed = strtoull(value, &end, 10);
+    if (errno == ERANGE || !parsed || *end) {
+        return false;
+    }
+
+    *generation = (uint64_t) parsed;
+    return true;
+}
+
+bool
+q3c_profile_validate_geometry(const struct q3c_profile *profile,
+                              uint32_t width, uint32_t height,
+                              bool output) {
+    if (!profile) {
+        return false;
+    }
+    return output
+        ? width == profile->output_width && height == profile->output_height
+        : width == profile->input_width && height == profile->input_height;
+}
