new file mode 100644
index 0000000..8fc8d77
--- /dev/null
+++ b/app/src/q3c/render_path.c
@@ -0,0 +1,63 @@
+#include "q3c/render_path.h"
+
+#include "util/log.h"
+#include "util/sdl.h"
+
+static bool
+q3c_default_clear(SDL_Renderer *renderer) {
+    return sc_sdl_render_clear(renderer);
+}
+
+static bool
+q3c_default_texture(SDL_Renderer *renderer, SDL_Texture *texture,
+                    const SDL_FRect *destination) {
+    bool ok = SDL_RenderTexture(renderer, texture, NULL, destination);
+    if (!ok) {
+        LOGE("Could not render texture: %s", SDL_GetError());
+    }
+    return ok;
+}
+
+static bool
+q3c_default_texture_rotated(SDL_Renderer *renderer, SDL_Texture *texture,
+                            const SDL_FRect *destination, double angle,
+                            SDL_FlipMode flip) {
+    bool ok = SDL_RenderTextureRotated(renderer, texture, NULL, destination,
+                                       angle, NULL, flip);
+    if (!ok) {
+        LOGE("Could not render rotated texture: %s", SDL_GetError());
+    }
+    return ok;
+}
+
+static bool
+q3c_default_present(SDL_Renderer *renderer) {
+    return sc_sdl_render_present(renderer);
+}
+
+const struct q3c_render_ops q3c_default_render_ops = {
+    .clear = q3c_default_clear,
+    .texture = q3c_default_texture,
+    .texture_rotated = q3c_default_texture_rotated,
+    .present = q3c_default_present,
+};
+
+bool
+q3c_render_path_execute(const struct q3c_render_ops *ops,
+                        SDL_Renderer *renderer, SDL_Texture *texture,
+                        const SDL_FRect *destination, bool rotated,
+                        double angle, SDL_FlipMode flip) {
+    if (!ops || !ops->clear || !ops->texture || !ops->texture_rotated
+            || !ops->present || !renderer || (texture && !destination)) {
+        return false;
+    }
+    bool clear_ok = ops->clear(renderer);
+    bool texture_ok = true;
+    if (texture) {
+        texture_ok = rotated
+            ? ops->texture_rotated(renderer, texture, destination, angle, flip)
+            : ops->texture(renderer, texture, destination);
+    }
+    bool present_ok = ops->present(renderer);
+    return clear_ok && texture_ok && present_ok;
+}
