@@ -0,0 +1,69 @@
+#include "q3c/render_ack.h"
+
+#include <string.h>
+
+#include "q3c/native_event.h"
+
+bool
+q3c_render_ack_dispatch(
+        bool render_succeeded, q3c_rendered_callback callback, void *userdata,
+        const AVFrame *frame, const struct sc_stream_session *session) {
+    if (!render_succeeded || !callback || !frame || !session) {
+        return false;
+    }
+    callback(userdata, frame, session);
+    return true;
+}
+
+bool
+q3c_direct_ready_init(struct q3c_direct_ready *ready,
+                      const struct q3c_profile *profile, uint64_t generation,
+                      q3c_render_event_emitter event_emitter) {
+    if (!ready || !profile || profile->stabilized || !generation) {
+        return false;
+    }
+    memset(ready, 0, sizeof(*ready));
+    if (!sc_mutex_init(&ready->mutex)) {
+        return false;
+    }
+    ready->profile = profile;
+    ready->generation = generation;
+    ready->event_emitter = event_emitter ? event_emitter : q3c_event_emit;
+    return true;
+}
+
+void
+q3c_direct_ready_destroy(struct q3c_direct_ready *ready) {
+    sc_mutex_destroy(&ready->mutex);
+}
+
+void
+q3c_direct_ready_ack_rendered(
+        void *userdata, const AVFrame *frame,
+        const struct sc_stream_session *session) {
+    struct q3c_direct_ready *ready = userdata;
+    if (!ready || !frame || !session || frame->pts == AV_NOPTS_VALUE
+            || frame->format != AV_PIX_FMT_YUV420P
+            || !q3c_profile_validate_geometry(ready->profile, (uint32_t) frame->width, (uint32_t) frame->height, true)
+            || !q3c_profile_validate_geometry(ready->profile, (uint32_t) session->video.width, (uint32_t) session->video.height, true)) {
+        return;
+    }
+
+    sc_mutex_lock(&ready->mutex);
+    if (!ready->ready_emitted) {
+        char event[Q3C_EVENT_MAX_BYTES + 1];
+        if (q3c_event_ready(event, sizeof(event), ready->profile->name,
+                            ready->profile->output_width,
+                            ready->profile->output_height, false,
+                            NULL, 0, ready->generation)) {
+            ready->event_emitter(event);
+            ready->ready_emitted = true;
+        } else if (q3c_event_diagnostic(
+                       event, sizeof(event), true,
+                       "native_protocol_error",
+                       "Could not encode native readiness event.")) {
+            ready->event_emitter(event);
+        }
+    }
+    sc_mutex_unlock(&ready->mutex);
+}
